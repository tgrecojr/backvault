# BackVault configuration template
# Copy to .env and fill in the values. Never commit .env.

# ---- Required ---------------------------------------------------------------

# Bitwarden personal API key (Settings -> Security -> Keys -> View API key).
# Must be a user key (user.<uuid>); organization keys cannot unlock a personal vault.
BW_CLIENT_ID=user.00000000-0000-0000-0000-000000000000
BW_CLIENT_SECRET=your_client_secret

# Master password. Used only inside the container to derive the vault key; never sent to the server.
BW_PASSWORD=your_master_password

# Server URL, https:// only.
# Self-hosted:    https://vault.example.com
# Bitwarden Cloud: https://vault.bitwarden.com  (or https://vault.bitwarden.eu)
BW_SERVER=https://vault.example.com

# Password that encrypts each backup file. Needed to restore; cannot be recovered if lost.
BW_FILE_PASSWORD=strong_backup_password

# ---- Optional ---------------------------------------------------------------

# Hours between backups (1 to 8760). One backup also runs immediately on start.
BACKUP_INTERVAL_HOURS=12

# Days to keep backups; cleanup runs once per UTC day. 0 disables cleanup.
RETAIN_DAYS=7

# Backup directory inside the container. Must lie under
#BACKUP_DIR=/app/backups

# Also append log lines to this file (stdout is always used).
#LOG_FILE=/app/backups/backvault.log

# Self-signed or private-CA server: mount your PEM bundname it here.
# It is trusted in addition to the built-in Mozilla roots. Verification can never be disabled.
#BW_CA_CERT=/app/ca.pem
